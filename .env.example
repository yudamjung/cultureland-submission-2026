# AI 검색 (RAG) 설정 — 값을 채워 .env.local로 저장하세요. 이 파일은 커밋하지 마세요.
OPENAI_API_KEY=
# 임베딩 모델 (문서·질문 공통). 바꾸면 npm run index를 다시 돌려야 합니다.
OPENAI_EMBED_MODEL=text-embedding-3-small
# 답변 생성 모델
OPENAI_CHAT_MODEL=gpt-4o-mini
# 검색 결과 개수 / 최소 유사도 (이하면 "못 찾았어요"로 답)
AI_TOP_K=5
AI_MIN_SCORE=0.25
# IP당 분당 요청 제한 (서버리스라 대략적인 제한입니다)
AI_RATE_LIMIT_PER_MIN=20
